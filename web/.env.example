# Base URL for the backend REST API as seen by the browser.
# Default "/api" works both in dev (Vite proxy) and prod (nginx reverse proxy),
# so you usually do not need to change this.
VITE_API_BASE_URL=/api

# Dev-server only: where Vite proxies "/api" and the WebSocket to.
# Used by vite.config.ts; ignored in the production (nginx) build.
VITE_DEV_API_TARGET=http://localhost:8080
