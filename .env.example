# Konatsu Mailer — environment overrides for docker compose.
# Copy to `.env` and edit. Every value has a safe default in docker-compose.yml,
# so `.env` is optional for a quick local trial — but you MUST change the secrets
# before exposing the app to a network.

# ─── Backend secrets (CHANGE THESE) ───────────────────────────────────────────
# AES-256 master key for encrypting mail/API passwords. Must be exactly 32 bytes.
# Generate one with:  openssl rand -hex 16
MASTER_ENC_KEY=0123456789abcdef0123456789abcdef

# JWT signing secret. Generate one with:  openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret

# Open or close self-service sign-up (set false to disable /auth/register).
ALLOW_REGISTRATION=true

# ─── Web Push / VAPID (optional) ──────────────────────────────────────────────
# Generate a key pair with:  npx web-push generate-vapid-keys
# Leave blank to disable push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ─── LLM defaults (per-user settings in the UI take precedence) ───────────────
LLM_WORKERS=4
NOTIFY_THRESHOLD=4
LLM_DEFAULT_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_DEFAULT_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Host port the web UI is published on (container always listens on :80).
FRONTEND_PORT=3000
